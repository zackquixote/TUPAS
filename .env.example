# Copy to .env for local dev (never commit .env).
DJANGO_DEBUG=1
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=tupas.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://tupas.vercel.app

# Database (leave empty for local SQLite)
DATABASE_URL=
POSTGRES_URL=

# Superuser (used during Vercel build)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@tupas.local

# AI providers (optional)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TUPAS_AI_PROVIDER=

# Local dev only
TUPAS_SHIELD_ENABLED=1
